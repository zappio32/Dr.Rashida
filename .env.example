```
# ──────────────────────────────────────────────
#  Dr. Rashida Ahmad — Frontend (Next.js) .env
#  For LOCAL DEVELOPMENT only.
#  Do NOT commit this file to Git.
# ──────────────────────────────────────────────

# Node environment
NODE_ENV=development

# Backend FastAPI URL (must be NEXT_PUBLIC_ to be exposed in the browser)
NEXT_PUBLIC_API_URL=http://localhost:8080

# The URL this frontend app is served on
APP_URL=http://localhost:3000

```